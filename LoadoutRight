window.printForms = async function(date, idx){
  const day = await loadDay(date);
  if(!day) return;
  const groups = groupByZoneDriver(day.records);
  const target = idx===null ? groups : [groups[idx]];
  const area = document.getElementById('printArea');
  area.innerHTML = target.map(g=>buildZqrFormHtml(date, g, true)).join('');
  setTimeout(()=>{
    renderQrPlaceholders(area);
    setTimeout(()=>window.print(), 150);
  }, 30);
}


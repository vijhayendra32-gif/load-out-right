async function drawReportPdf(doc, date, rd){
  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const marginX = 14;
  const m = rd.manual;
  let cursorY;

  function ensureSpace(needed){
    if(cursorY + needed > pageHeight - 15){ doc.addPage(); cursorY = 18; }
  }
  function sectionLabel(text){
    ensureSpace(12);
    doc.setDrawColor(20); doc.setLineWidth(0.5);
    doc.line(marginX, cursorY, pageWidth-marginX, cursorY);
    cursorY += 5;
    doc.setFontSize(10.5); doc.setFont('helvetica','bold'); doc.setTextColor(15);
    doc.text(text, marginX, cursorY);
    cursorY += 3;
  }
  function kvTable(rows){
    doc.autoTable({
      startY: cursorY,
      margin:{ left:marginX, right:marginX },
      theme:'plain',
      body: rows,
      styles:{ fontSize:9, cellPadding:2, textColor:20 },
      columnStyles:{ 0:{fontStyle:'bold', cellWidth:80}, 1:{halign:'left'} }
    });
    cursorY = doc.lastAutoTable.finalY + 8;
  }
  function dataTable(head, body){
    doc.autoTable({
      startY: cursorY,
      margin:{ left:marginX, right:marginX },
      head:[head],
      body: body.length ? body : [head.map((_,i)=> i===0 ? 'None' : '')],
      styles:{ fontSize:8.5, cellPadding:2.5, lineColor:[150,150,150], lineWidth:0.2, textColor:20 },
      headStyles:{ fillColor:[242,242,242], textColor:20, fontStyle:'bold', fontSize:8 }
    });
    cursorY = doc.lastAutoTable.finalY + 8;
  }

  doc.setFont('helvetica','bold'); doc.setFontSize(16); doc.setTextColor(20);
  doc.text('IKEA', marginX, 16);
  doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(90);
  doc.text('Goods Outflow · Adelaide', marginX, 21);
  doc.setFont('helvetica','bold'); doc.setFontSize(13); doc.setTextColor(20);
  doc.text('DAILY LOAD-OUT REPORT', pageWidth-marginX, 16, {align:'right'});
  doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(90);
  doc.text(date, pageWidth-marginX, 21, {align:'right'});
  cursorY = 27;

  kvTable([
    ['Controller', m.repController||'—'],
    ['Load Out Hours', m.repHours||'—'],
    ['Last Vehicle Left', m.repLastVehicle||'—'],
    ['Tent Check', yesNoLabel(m.repTent)],
    ['TMP Check', yesNoLabel(m.repTmp)],
    ['Zone Clear', yesNoLabel(m.repTrolleys)],
    ['ANC Supervisor Present', yesNoLabel(m.repAnc)],
    ['No. of Vans', String(rd.vans)],
    ['No. of Trucks', String(rd.trucks)],
    ['Total Load-Out Orders', String(rd.totalOrders)],
    ['Total Netley Orders', String(rd.totalNetley)],
    ['Total Preload', String(rd.totalPreload)],
    ['First Zone Delivery', rd.firstDelivery],
    ['Last Zone Delivery', rd.lastDelivery]
  ]);

  sectionLabel('DRIVER SNAPSHOT');
  dataTable(['Driver No.','Zone','Netley Connect','No. of Orders'],
    rd.driverSnapshot.map(d=>[d.driverNo, d.zone, d.hasNetley?'Yes':'No', String(d.orderCount)]));

  sectionLabel('PRELOAD');
  dataTable(['Zone','Driver No.','No. of Orders'],
    rd.preloadSnapshot.map(p=>[p.zone, p.driverNo, String(p.orderCount)]));

  sectionLabel('FAILED DELIVERY (not delivered by 10:00am)');
  dataTable(['Order No.','Driver No.','Zone','Suburb'],
    rd.failedRecords.map(r=>[r.orderNo, r.driverNo, r.zone, r.suburb]));

  sectionLabel('EXTERNAL RETURNS ASSIGNED');
  dataTable(['Order No.','Driver No.','Zone'],
    rd.externalReturns.map(r=>[r.orderNo, r.driverNo, r.zone]));

  sectionLabel('OTHER ISSUES');
  ensureSpace(14);
  doc.setDrawColor(180); doc.setLineWidth(0.3);
  const issuesText = m.repOtherIssues || 'None';
  const issuesLines = doc.splitTextToSize(issuesText, pageWidth-2*marginX-8);
  const boxHeight = Math.max(10, issuesLines.length*4.5+6);
  ensureSpace(boxHeight);
  doc.rect(marginX, cursorY, pageWidth-2*marginX, boxHeight);
  doc.setFontSize(9); doc.setFont('helvetica','normal'); doc.setTextColor(m.repOtherIssues ? 20 : 130);
  doc.text(issuesLines, marginX+4, cursorY+6);
  cursorY += boxHeight + 8;

  doc.setFontSize(8); doc.setTextColor(140); doc.setFont('helvetica','normal');
  doc.text('IKEA Adelaide · Goods Outflow (GFO) · Load Out Right Initiative', pageWidth/2, pageHeight-10, {align:'center'});
}

window.viewReportPdf = async function(){
  try{
    if(!window.jspdf || !window.jspdf.jsPDF){ throw new Error('PDF library (jsPDF) did not load — check your internet connection.'); }
    const date = document.getElementById('reportDate').value || todayISO();
    toast('Building PDF…');
    const rd = await computeReportData(date);
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({unit:'mm', format:'a4'});
    if(typeof doc.autoTable !== 'function'){ throw new Error('PDF table library (autotable) did not load — check your internet connection.'); }
    await drawReportPdf(doc, date, rd);
    const filename = 'LoadOut_Report_'+date+'.pdf';
    showPdfModal('Load-Out Report — '+date, doc, filename, currentReportHtml || buildReportHtml(date, rd));
  }catch(err){
    console.error(err);
    toast('Could not build the PDF: '+err.message);
  }
}
</script>
</body>
</html>

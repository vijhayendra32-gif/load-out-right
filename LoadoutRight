<script>
/* ============================= STORAGE HELPERS =============================
   Uses the browser's own localStorage so this works when the file is opened
   directly (double-clicked, or served from disk) — not just inside a live
   Claude.ai artifact preview. Note: localStorage is per-browser, per-device —
   data uploaded on one computer will not automatically appear on a different
   phone/computer's browser. See the note at the end of this file's response
   if you need uploads on a PC to be visible to phones scanning elsewhere. */
const STORAGE_PREFIX = 'loadoutApp:';

async function storeGet(key){
  try{
    return localStorage.getItem(STORAGE_PREFIX + key);
  }catch(e){ console.error('storage get failed', e); return null; }
}
async function storeSet(key, value){
  try{ localStorage.setItem(STORAGE_PREFIX + key, value); return true; }
  catch(e){ console.error('storage set failed', e); return false; }
}
async function storeDelete(key){
  try{ localStorage.removeItem(STORAGE_PREFIX + key); return true; }
  catch(e){ console.error('storage delete failed', e); return false; }
}

async function loadDatesIndex(){
  const raw = await storeGet('loadout:dates');
  if(!raw) return [];
  try{ return JSON.parse(raw); }catch(e){ return []; }
}
async function saveDatesIndex(list){
  await storeSet('loadout:dates', JSON.stringify(list));
}
async function addDateToIndex(date){
  const list = await loadDatesIndex();
  if(!list.includes(date)){
    list.push(date);
    list.sort().reverse();
    await saveDatesIndex(list);
  }
}
async function loadDay(date){
  const raw = await storeGet('loadout:day:'+date);
  if(!raw) return null;
  try{ return JSON.parse(raw); }catch(e){ return null; }
}
async function saveDay(date, dayObj){
  await storeSet('loadout:day:'+date, JSON.stringify(dayObj));
}
async function loadReportData(date){
  const raw = await storeGet('loadout:report:'+date);
  if(!raw) return {};
  try{ return JSON.parse(raw); }catch(e){ return {}; }
}
async function saveReportData(date, data){
  await storeSet('loadout:report:'+date, JSON.stringify(data));
}

/* ---- Data retention: keep only the last RETENTION_DAYS calendar days ---- */
const RETENTION_DAYS = 3;
function isoDaysAgo(n){
  const d = new Date();
  d.setDate(d.getDate()-n);
  const tz = d.getTimezoneOffset();
  const local = new Date(d.getTime()-tz*60000);
  return local.toISOString().slice(0,10);
}
async function cleanupOldData(){
  const cutoff = isoDaysAgo(RETENTION_DAYS-1); // e.g. today, today-1, today-2 for RETENTION_DAYS=3
  const dates = await loadDatesIndex();
  const keep = [];
  let removedAny = false;
  for(const d of dates){
    if(d >= cutoff){
      keep.push(d);
    }else{
      await storeDelete('loadout:day:'+d);
      await storeDelete('loadout:report:'+d);
      removedAny = true;
    }
  }
  if(removedAny) await saveDatesIndex(keep);
}

/* ============================= UTIL ============================= */
function todayISO(){
  const d = new Date();
  const tz = d.getTimezoneOffset();
  const local = new Date(d.getTime() - tz*60000);
  return local.toISOString().slice(0,10);
}
function formatDDMMYY(dateStr){
  const [y,m,d] = dateStr.split('-');
  return d+m+y.slice(2);
}
function buildZqrCode(zone, dateStr){
  return zone+'-'+formatDDMMYY(dateStr);
}
function toast(msg, ms=2400){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._h);
  t._h = setTimeout(()=>t.classList.remove('show'), ms);
}
function beep(freq=880, dur=180){
  try{
    const ctx = new (window.AudioContext||window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type='square'; osc.frequency.value=freq;
    gain.gain.value=0.15;
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start();
    setTimeout(()=>{ osc.stop(); ctx.close(); }, dur);
  }catch(e){}
}
function escapeHtml(s){
  return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function uid(){ return Math.random().toString(36).slice(2,10); }

/* Header normalization for flexible Excel column matching */
function normHeader(h){
  return String(h||'').toLowerCase().replace(/[^a-z0-9]/g,'');
}
const HEADER_ALIASES = {
  category: ['category','cat'],
  orderNo: ['orderno','orderno','order#','ordernumber','order','ordernum'],
  driverNo: ['driverno','driver#','drivernumber','driver','drivernum'],
  driverName: ['drivername','drivernamefull'],
  zone: ['zone','zonebay','bay','zonebayno'],
  suburb: ['suburb','location','suburblocation','deliverysuburb'],
  items: ['item','items','itemno','itemnos','itemnumber','itemnum','noofitems','numitems','numberofitems','itemcount','noofboxes','noboxes','numboxes','numberofboxes','boxes','qty','quantity','boxcount'],
  details: ['details','detail','notes','note','description']
};
function detectColumns(headerRow){
  const map = {};
  headerRow.forEach((h, idx)=>{
    const n = normHeader(h);
    for(const field in HEADER_ALIASES){
      if(HEADER_ALIASES[field].includes(n) && map[field]===undefined){
        map[field] = idx;
      }
    }
  });
  // Priority tier 2: an explicit "item"/"items" column always wins for the items field,
  // even if a legacy "boxes"/"qty"-style column sits earlier in the sheet.
  headerRow.forEach((h, idx)=>{
    const n = normHeader(h);
    if(n==='item' || n==='items'){ map.items = idx; }
  });
  // Priority tier 1 (highest): an "itemNo"-style column always wins over everything else
  // for the items field, including a plain "Item"/"Items" column, since when both exist
  // itemNo is the one carrying the real per-order quantity.
  headerRow.forEach((h, idx)=>{
    const n = normHeader(h);
    if(n==='itemno' || n==='itemnos' || n==='itemnumber' || n==='itemnum'){ map.items = idx; }
  });
  return map;
}

/* ============================= STATE ============================= */
let currentScanOrder = null; // {date, orderNo, zone, driverNo, category, suburb, items}
let camStream = null;
let camRAF = null;

/* ============================= NAVIGATION ============================= */
document.getElementById('tabs').addEventListener('click', (e)=>{
  const btn = e.target.closest('button[data-view]');
  if(!btn) return;

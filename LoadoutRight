document.getElementById('clearDateBtn').addEventListener('click', async ()=>{
  const date = document.getElementById('uploadDate').value;
  const statusEl = document.getElementById('clearDateStatus');
  if(!date){ statusEl.textContent = 'Choose a date first.'; return; }

  const day = await loadDay(date);
  if(!day || !day.records.length){
    statusEl.textContent = 'No data found for '+date+'.';
    return;
  }
  const ok = confirm('Delete all '+day.records.length+' order(s) and ZQR forms for '+date+'? This cannot be undone.');
  if(!ok) return;

  await storeDelete('loadout:day:'+date);
  await storeDelete('loadout:report:'+date);
  const dates = (await loadDatesIndex()).filter(d=>d!==date);
  await saveDatesIndex(dates);

  statusEl.innerHTML = '<span style="color:var(--success); font-weight:700;">Cleared all data for '+date+'.</span>';
  if(lastUploadDate===date){ lastUploadDate=null; lastUploadGroups=null; document.getElementById('uploadPreviewCard').style.display='none'; }
  if(document.getElementById('formsDate').value===date) renderFormsList();
  if(document.getElementById('dashDate').value===date) refreshDashboard();
  if(document.getElementById('recordsDate').value===date){ liveOrderLookup(); if(searchHasRun) runSearch(); }
  if(document.getElementById('reportDate').value===date) refreshReport();
});


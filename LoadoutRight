function renderQrPlaceholders(container){
  const html = container.innerHTML;
  const re = /<!--QR::(.*?)::(.*?)-->/g;
  let m;
  while((m = re.exec(html))){
    const id = m[1], text = m[2];
    const el = container.querySelector('#'+id) || document.getElementById(id);
    if(!el) continue;
    if(window.QRCode){
      el.innerHTML='';
      try{ new QRCode(el, {text, width:76, height:76, correctLevel: QRCode.CorrectLevel.M}); }
      catch(e){ el.innerHTML = qrFallbackHtml(text); }
    }else{
      el.innerHTML = qrFallbackHtml(text);
    }
  }
}
function qrFallbackHtml(text){
  return '<div style="width:76px;height:76px;border:1.5px dashed #999;display:flex;align-items:center;'
    + 'justify-content:center;text-align:center;font-size:8px;line-height:1.2;padding:4px;color:#900;">'
    + 'QR unavailable — code:<br><b style="font-family:monospace;">'+escapeHtml(text)+'</b></div>';
}

/* ============================= PDF GENERATION ============================= */
function qrDataUrl(text, size){
  return new Promise((resolve)=>{
    const div = document.createElement('div');
    div.style.position='fixed'; div.style.left='-9999px'; div.style.top='0';
    document.body.appendChild(div);
    try{ new QRCode(div, {text, width:size, height:size, correctLevel: QRCode.CorrectLevel.M}); }catch(e){}
    setTimeout(()=>{
      let url = null;
      const canvas = div.querySelector('canvas');
      if(canvas){ url = canvas.toDataURL('image/png'); }
      else{ const img = div.querySelector('img'); if(img) url = img.src; }
      document.body.removeChild(div);
      resolve(url);
    }, 30);
  });
}

async function drawZqrFormPdf(doc, date, g, startNewPage){
  if(startNewPage) doc.addPage();
  const pageWidth = doc.internal.pageSize.getWidth();
  const marginX = 14;

  // Top bar: brand left, form title right
  doc.setFont('helvetica','bold'); doc.setFontSize(16); doc.setTextColor(20);
  doc.text('IKEA', marginX, 16);
  doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(90);
  doc.text('Goods Outflow · Adelaide', marginX, 21);

  doc.setFont('helvetica','bold'); doc.setFontSize(13); doc.setTextColor(20);
  doc.text('ZONE QR & DRIVER HANDOUT FORM', pageWidth-marginX, 16, {align:'right'});
  doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(90);
  doc.text('ZQR · Complete before driver departs', pageWidth-marginX, 21, {align:'right'});

  doc.setDrawColor(20); doc.setLineWidth(0.8);
  doc.line(marginX, 25, pageWidth-marginX, 25);

  // Info box: Zone/Bay, Date, Driver Name, Driver No. + QR
  const boxTop = 31, boxHeight = 30;
  doc.setDrawColor(150); doc.setLineWidth(0.3);
  doc.rect(marginX, boxTop, pageWidth-2*marginX, boxHeight);

  function fieldBlock(label, value, x, y){
    doc.setFontSize(7.5); doc.setTextColor(110); doc.setFont('helvetica','bold');
    doc.text(label, x, y);
    doc.setFontSize(13); doc.setTextColor(15); doc.setFont('helvetica','bold');
    doc.text(String(value||''), x, y+6);
  }
  fieldBlock('ZONE / BAY LOCATION', g.zone, marginX+6, boxTop+11);
  fieldBlock('DATE', date, marginX+95, boxTop+11);
  fieldBlock('DRIVER NAME', '', marginX+6, boxTop+24);
  fieldBlock('DRIVER NO.', g.driverNo, marginX+95, boxTop+24);

  const zqrText = buildZqrCode(g.zone, date);
  const zqrImg = await qrDataUrl(zqrText, 160);
  const qrSize = 16;
  const qrX = pageWidth - marginX - qrSize - 10;
  const qrY = boxTop + 4;
  if(zqrImg){
    doc.addImage(zqrImg, 'PNG', qrX, qrY, qrSize, qrSize);
  }else{
    doc.setDrawColor(180); doc.setLineWidth(0.3);
    doc.rect(qrX, qrY, qrSize, qrSize);
    doc.setFontSize(6); doc.setTextColor(150);
    doc.text('QR unavailable', qrX+qrSize/2, qrY+qrSize/2-2, {align:'center', maxWidth:qrSize});
  }
  doc.setFontSize(6.5); doc.setFont('helvetica','bold'); doc.setTextColor(60);
  doc.text('SCAN TO CONFIRM', qrX+qrSize/2, qrY+qrSize+3.5, {align:'center'});
  doc.setFontSize(8); doc.setFont('helvetica','bold'); doc.setTextColor(20);
  doc.text(zqrText, qrX+qrSize/2, qrY+qrSize+8, {align:'center'});

  // Section label + table
  let y = boxTop+boxHeight+10;
  doc.setDrawColor(20); doc.setLineWidth(0.6);
  doc.line(marginX, y, pageWidth-marginX, y);
  doc.setFontSize(10.5); doc.setFont('helvetica','bold'); doc.setTextColor(15);
  doc.text('ORDERS LOADED TO THIS ZONE', marginX, y+6);

  doc.autoTable({
    startY: y+10,
    margin:{ left:marginX, right:marginX },
    head:[['#','Order No.','Suburb','No. of Items','Loaded']],
    body: g.records.map((r,i)=>[String(i+1), r.orderNo, r.suburb, String(r.items), '']),
    styles:{ fontSize:9, cellPadding:3, lineColor:[150,150,150], lineWidth:0.2, textColor:20 },
    headStyles:{ fillColor:[242,242,242], textColor:20, fontStyle:'bold', fontSize:8 },
    columnStyles:{ 0:{cellWidth:10, halign:'center'}, 3:{cellWidth:28, halign:'center'}, 4:{cellWidth:22, halign:'center'} },
    didParseCell:(data)=>{
      if(data.section==='body'){
        const rec = g.records[data.row.index];
        if(rec && rec.isNetley) data.cell.styles.fillColor = [228,230,233];
      }
    }
  });

  let finalY = doc.lastAutoTable.finalY + 12;
  doc.setDrawColor(20); doc.setLineWidth(0.6);
  doc.line(marginX, finalY, pageWidth-marginX, finalY);
  doc.setFontSize(10.5); doc.setFont('helvetica','bold'); doc.setTextColor(15);
  doc.text('DRIVER SIGN-OFF — TO BE COMPLETED BEFORE LEAVING', marginX, finalY+6);
  doc.setFontSize(9); doc.setFont('helvetica','normal'); doc.setTextColor(70);
  doc.text('I confirm I have received the goods listed above, in good condition, for the zone and bay stated.', marginX, finalY+12);

  const signY = finalY+28;
  const colWidth = (pageWidth-2*marginX-3*8)/4;
  ['SIGNATURE','PRINTED NAME','DATE','TIME'].forEach((lab,i)=>{
    const x = marginX + i*(colWidth+8);
    doc.setFontSize(7.5); doc.setTextColor(110); doc.setFont('helvetica','bold');
    doc.text(lab, x, signY-3);
    doc.setDrawColor(120); doc.setLineWidth(0.3);
    doc.line(x, signY, x+colWidth, signY);
  });

  doc.setFontSize(8); doc.setTextColor(140); doc.setFont('helvetica','normal');
  doc.text('IKEA Adelaide · Goods Outflow (GFO) · Load Out Right Initiative', pageWidth/2, 287, {align:'center'});
}

function showPdfModal(title, doc, filename, previewHtml){
  document.getElementById('pdfModalTitle').textContent = title;
  document.getElementById('pdfPreviewArea').innerHTML = previewHtml;
  setTimeout(()=>renderQrPlaceholders(document.getElementById('pdfPreviewArea')), 30);

  function download(){
    try{
      doc.save(filename);
      return true;
    }catch(e){
      console.error(e);
      return false;
    }
  }

  const banner = document.getElementById('pdfSavedBanner');
  if(download()){
    banner.textContent = 'Downloaded as '+filename+' — check your Downloads folder to open or print it.';
  }else{
    banner.textContent = 'Could not auto-download — use the Download PDF button below.';
  }
  document.getElementById('pdfDownloadBtn').onclick = download;
  document.getElementById('pdfModalOverlay').classList.add('show');
}

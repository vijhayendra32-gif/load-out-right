}

/* Refresh dashboard / records / report whenever localStorage changes in another tab of this browser */
window.addEventListener('storage', (e)=>{
  if(!e.key || e.key.indexOf(STORAGE_PREFIX)!==0) return;
  if(document.getElementById('view-dashboard').classList.contains('active')) refreshDashboard();
  if(document.getElementById('view-search').classList.contains('active')){
    liveOrderLookup();
    if(searchHasRun) runSearch();
  }
  if(document.getElementById('view-report').classList.contains('active')) refreshReportAutoFieldsOnly();
});

let lastKnownToday = todayISO();
function checkDateRollover(){
  const freshToday = todayISO();
  if(freshToday !== lastKnownToday){
    // The calendar day has changed while this tab was open. Any date field
    // still sitting on the OLD "today" should advance to the new one —
    // fields the user deliberately set to a different/past date are left alone.
    ['dashDate','uploadDate','formsDate','recordsDate','reportDate'].forEach(id=>{
      const el = document.getElementById(id);
      if(el && el.value === lastKnownToday) el.value = freshToday;
    });
    document.getElementById('todayLabel').textContent = freshToday;
    lastKnownToday = freshToday;
  }
}

function isPreload(record){
  return /^PL\d+$/i.test(String(record.zone||'').trim());
}

async function refreshDashboard(){
  checkDateRollover();
  const date = document.getElementById('dashDate').value || todayISO();
  const day = await loadDay(date);
  const dashRecords = day ? day.records.filter(r=>!isPreload(r)) : [];
  const counts = { pending:0, 'in-transit':0, delivered:0 };
  let total = 0;
  if(dashRecords.length){
    dashRecords.forEach(r=>{ if(counts[r.status]!==undefined) counts[r.status]++; });
    total = dashRecords.length;
  }
  document.getElementById('dashPendingNum').textContent = counts.pending;
  document.getElementById('dashTransitNum').textContent = counts['in-transit'];
  document.getElementById('dashDeliveredNum').textContent = counts.delivered;
  document.getElementById('dashEmpty').style.display = total ? 'none' : 'block';

  const timesEl = document.getElementById('dashDeliveryTimes');
  const chartEl = document.getElementById('dashChart');
  const driverCard = document.getElementById('dashDriverCard');
  if(!total){ chartEl.innerHTML=''; timesEl.style.display='none'; driverCard.style.display='none'; return; }

  const rows = [
    ['Pending','pending',counts.pending],
    ['In Transit','in-transit',counts['in-transit']],
    ['Delivered','delivered',counts.delivered]
  ];
  chartEl.innerHTML = rows.map(([label,cls,count])=>{
    const pct = total ? Math.round((count/total)*100) : 0;
    return '<div class="dash-bar-row">'
      + '<div class="dash-bar-label">'+label+'</div>'
      + '<div class="dash-bar-track"><div class="dash-bar-fill '+cls+'" style="width:'+pct+'%;"></div></div>'
      + '<div class="dash-bar-count">'+count+'</div>'
      + '</div>';
  }).join('');

  const deliveredTimes = dashRecords
    .filter(r=>r.status==='delivered' && r.deliveredAt)
    .map(r=>r.deliveredAt)
    .sort();
  if(deliveredTimes.length){
    const fmt = (iso)=> new Date(iso).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'});
    document.getElementById('dashFirstDelivered').textContent = fmt(deliveredTimes[0]);
    document.getElementById('dashLastDelivered').textContent = fmt(deliveredTimes[deliveredTimes.length-1]);
    timesEl.style.display = 'flex';
  }else{
    timesEl.style.display = 'none';
  }

  driverCard.style.display = 'block';
  renderDriverProgress(date, dashRecords);
}
document.getElementById('dashDate').addEventListener('change', refreshDashboard);

/* ---- Per-driver progress vs the 07:00 daily target ---- */
const DAILY_TARGET_HOUR = 7; // 07:00
const FAILED_AFTER_HOURS = 5; // orders not delivered 5h past the target are marked failed

function groupByDriverOnly(records){
  const map = {};
  records.forEach(r=>{
    if(!map[r.driverNo]) map[r.driverNo] = { driverNo:r.driverNo, records:[] };
    map[r.driverNo].records.push(r);
  });
  return Object.values(map).sort((a,b)=> String(a.driverNo).localeCompare(String(b.driverNo)));
}

function formatHM(totalMinutes){
  const h = Math.floor(totalMinutes/60);
  const m = totalMinutes%60;
  if(h <= 0) return m+'m';
  return h+'h '+m+'m';
}

function isOrderFailed(record, date, deadline, failCutoff, isToday, now){
  if(record.status==='delivered') return false;
  if(!isToday) return date < todayISO(); // any past, undelivered order is failed
  return now > failCutoff;
}

function renderDriverProgress(date, records){
  const el = document.getElementById('dashDriverProgress');
  const drivers = groupByDriverOnly(records);
  const deadline = new Date(date+'T'+String(DAILY_TARGET_HOUR).padStart(2,'0')+':00:00');
  const failCutoff = new Date(deadline.getTime() + FAILED_AFTER_HOURS*60*60000);
  const isToday = date === todayISO();
  const now = new Date();

  el.innerHTML = drivers.map(d=>{
    const total = d.records.length;
    const failed = d.records.filter(r=>isOrderFailed(r, date, deadline, failCutoff, isToday, now)).length;
    const pending = d.records.filter(r=>r.status==='pending' && !isOrderFailed(r, date, deadline, failCutoff, isToday, now)).length;
    const transit = d.records.filter(r=>r.status==='in-transit' && !isOrderFailed(r, date, deadline, failCutoff, isToday, now)).length;
    const delivered = d.records.filter(r=>r.status==='delivered').length;
    const pct = total ? Math.round((delivered/total)*100) : 0;
    const pendingPct = total ? (pending/total)*100 : 0;
    const transitPct = total ? (transit/total)*100 : 0;
    const deliveredPct = total ? (delivered/total)*100 : 0;
    const failedPct = total ? (failed/total)*100 : 0;
    const cappedMin = FAILED_AFTER_HOURS*60;

    let statusHtml = '';
    let overdue = false;
    if(failed > 0){
      overdue = true;
      statusHtml = '<span class="driver-status failed">'+failed+' failed \u2014 '+formatHM(cappedMin)+'+ past 07:00</span>';
    }else if(delivered === total && total > 0){
      const times = d.records.filter(r=>r.deliveredAt).map(r=>r.deliveredAt).sort();
      const lastAt = times.length ? new Date(times[times.length-1]) : null;
      if(lastAt){
        const diffMin = Math.round((lastAt - deadline)/60000);
        if(diffMin > 0){
          overdue = true;
          statusHtml = '<span class="driver-status late">Finished '+formatHM(diffMin)+' past 07:00</span>';
        }else{
          statusHtml = '<span class="driver-status ontime">Finished on time</span>';
        }
      }else{
        statusHtml = '<span class="driver-status ontime">Complete</span>';
      }
    }else if(isToday){
      const diffMin = Math.round((now - deadline)/60000);
      if(diffMin > 0){
        overdue = true;
        statusHtml = '<span class="driver-status late">'+formatHM(diffMin)+' past 07:00</span>';
      }else{
        statusHtml = '<span class="driver-status pending">Due in '+formatHM(-diffMin)+'</span>';
      }
    }else{
      overdue = true;
      statusHtml = '<span class="driver-status late">Incomplete</span>';
    }

    return '<div class="driver-row">'
      + '<div class="driver-row-head"><span class="driver-id mono">Driver '+escapeHtml(d.driverNo)+'</span>'
      + '<span class="driver-pct">'+pct+'% complete</span>'+statusHtml+'</div>'
      + '<div class="driver-bar-track'+(overdue?' overdue':'')+'">'
      +   (pendingPct>0 ? '<div class="driver-bar-seg pending" style="width:'+pendingPct+'%;"></div>' : '')
      +   (transitPct>0 ? '<div class="driver-bar-seg in-transit" style="width:'+transitPct+'%;"></div>' : '')
      +   (deliveredPct>0 ? '<div class="driver-bar-seg delivered" style="width:'+deliveredPct+'%;"></div>' : '')
      +   (failedPct>0 ? '<div class="driver-bar-seg failed" style="width:'+failedPct+'%;"></div>' : '')
      + '</div>'
      + '</div>';
  }).join('');
}


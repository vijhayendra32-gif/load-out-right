async function handleScan(raw){
  if(!currentScanOrder){
    await handleOrderScan(raw);
  }else{
    await handleZqrScan(raw);
  }
}

function parseOrderCode(raw){
  const parts = raw.split(':');
  if(parts[0]==='ORDER' && parts.length>=3){
    return { date: parts[1], orderNo: parts.slice(2).join(':') };
  }
  return { date: null, orderNo: raw };
}
function parseZqrCode(raw){
  const idx = raw.lastIndexOf('-');
  if(idx <= 0) return null;
  const zone = raw.slice(0, idx);
  const dateCode = raw.slice(idx+1);
  if(!/^\d{6}$/.test(dateCode)) return null;
  return { zone, dateCode };
}

async function handleOrderScan(raw){
  const parsed = parseOrderCode(raw);
  let date = parsed.date || document.getElementById('formsDate').value || todayISO();
  let day = await loadDay(date);
  let rec = day ? day.records.find(r=>r.orderNo===parsed.orderNo) : null;

  if(!rec){
    // fall back: search all dates for this order number
    const dates = await loadDatesIndex();
    for(const d of dates){
      const dObj = await loadDay(d);
      const found = dObj && dObj.records.find(r=>r.orderNo===parsed.orderNo);
      if(found){ rec = found; date = d; day = dObj; break; }
    }
  }
  if(!rec){
    toast('Order '+parsed.orderNo+' not found');
    beep(220,220);
    return;
  }
  currentScanOrder = { date, orderNo: rec.orderNo, zone: rec.zone, driverNo: rec.driverNo,
                        category: rec.category, suburb: rec.suburb, items: rec.items, recId: rec.id };
  if(rec.status==='pending'){
    rec.status = 'in-transit';
    rec.inTransitAt = new Date().toISOString();
    await saveDay(date, day);
  }
  renderScanStages();
}

async function handleZqrScan(raw){
  const z = parseZqrCode(raw);
  const stageEl = document.getElementById('stageBWrap');
  if(!z){
    toast('Not a recognised ZQR code');
    beep(220,220);
    return;
  }
  const match = z.zone===currentScanOrder.zone && z.dateCode===formatDDMMYY(currentScanOrder.date);
  if(match){
    // mark delivered
    const day = await loadDay(currentScanOrder.date);
    const rec = day.records.find(r=>r.id===currentScanOrder.recId);
    if(rec){ rec.status='delivered'; rec.deliveredAt = new Date().toISOString(); await saveDay(currentScanOrder.date, day); }
    beep(1046,140);
    stageEl.innerHTML = renderStageB('match');
    setTimeout(()=>{ currentScanOrder=null; renderScanStages(); scanInput.focus(); }, 1600);
  }else{
    beep(180,320);
    stageEl.innerHTML = renderStageB('mismatch');
  }
}

function renderStageB(result){
  const manualRow = '<div class="manual-zqr-row">'
    + '<input type="text" id="manualZqrInput" placeholder="Or type the zone code, e.g. 1-310726" autocomplete="off" '
    + 'onkeydown="if(event.key===\'Enter\'){ event.preventDefault(); handleManualZqr(); }"/>'

/* Camera scanning */
const camToggleBtn = document.getElementById('camToggleBtn');
camToggleBtn.addEventListener('click', ()=>{
  if(camStream) stopCamera(); else startCamera();
});
async function startCamera(){
  const wrap = document.getElementById('camWrap');
  const video = document.getElementById('camVideo');

  const isSecure = window.isSecureContext || location.protocol === 'https:' || location.hostname === 'localhost';
  if(!isSecure || !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    toast('Camera needs this page served over https:// — it will not work opened as a local file or over plain http://. Use the text field or a handheld scanner instead.', 6000);
    return;
  }

  try{
    camStream = await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'}});
    video.srcObject = camStream;
    await video.play();
    wrap.style.display='block';
    camToggleBtn.textContent = 'Stop camera';
    scanLoop();
  }catch(e){
    console.error(e);
    let msg = 'Camera unavailable — use the text field or a handheld scanner instead.';
    if(e.name==='NotAllowedError') msg = 'Camera permission was denied — check your browser/site settings and allow camera access.';
    else if(e.name==='NotFoundError') msg = 'No camera found on this device.';
    else if(e.name==='NotReadableError') msg = 'Camera is already in use by another app.';
    else if(e.name==='SecurityError') msg = 'Camera blocked — this page must be served over https:// to use the camera.';
    toast(msg, 6000);
  }
}
function stopCamera(){
  if(camRAF) cancelAnimationFrame(camRAF);
  if(camStream){ camStream.getTracks().forEach(t=>t.stop()); camStream=null; }
  document.getElementById('camWrap').style.display='none';
  camToggleBtn.textContent = 'Use camera';
}
function scanLoop(){
  const video = document.getElementById('camVideo');
  const canvas = document.getElementById('camCanvas');
  const ctx = canvas.getContext('2d');
  function tick(){
    if(!camStream) return;
    if(video.readyState===video.HAVE_ENOUGH_DATA){
      canvas.width = video.videoWidth; canvas.height = video.videoHeight;
      ctx.drawImage(video,0,0,canvas.width,canvas.height);
      const imgData = ctx.getImageData(0,0,canvas.width,canvas.height);
      const code = window.jsQR && jsQR(imgData.data, imgData.width, imgData.height);
      if(code && code.data){
        handleScan(code.data.trim());
        stopCamera();
        return;
      }
    }
    camRAF = requestAnimationFrame(tick);
  }
  camRAF = requestAnimationFrame(tick);
}


window.viewFormPdf = async function(date, idx){
  try{
    if(!window.jspdf || !window.jspdf.jsPDF){ throw new Error('PDF library (jsPDF) did not load — check your internet connection.'); }
    const groups = window._formsCache;
    const g = groups && groups[idx];
    if(!g){ throw new Error('Could not find that form — try reopening the ZQR Forms page.'); }
    toast('Building PDF…');
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({unit:'mm', format:'a4'});
    if(typeof doc.autoTable !== 'function'){ throw new Error('PDF table library (autotable) did not load — check your internet connection.'); }
    await drawZqrFormPdf(doc, date, g, false);
    const filename = 'ZQR_'+date+'_Zone-'+g.zone+'_Driver-'+g.driverNo+'.pdf';
    showPdfModal('Zone '+g.zone+' — Driver '+g.driverNo, doc, filename, buildZqrFormHtml(date, g));
  }catch(err){
    console.error(err);
    toast('Could not build the PDF: '+err.message);
  }
}

window.viewAllFormsPdf = async function(date){
  try{
    const day = await loadDay(date);
    if(!day || !day.records.length){ throw new Error('No data uploaded for '+date+'.'); }
    if(!window.jspdf || !window.jspdf.jsPDF){ throw new Error('PDF library (jsPDF) did not load — check your internet connection.'); }
    toast('Building PDF…');
    const groups = groupByZoneDriver(day.records);
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({unit:'mm', format:'a4'});
    if(typeof doc.autoTable !== 'function'){ throw new Error('PDF table library (autotable) did not load — check your internet connection.'); }
    for(let i=0;i<groups.length;i++){ await drawZqrFormPdf(doc, date, groups[i], i>0); }
    const filename = 'ZQR_'+date+'_all-forms.pdf';
    const previewHtml = groups.map(g=>buildZqrFormHtml(date, g)).join('');
    showPdfModal('All ZQR forms — '+date, doc, filename, previewHtml);
  }catch(err){
    console.error(err);
    toast('Could not build the PDF: '+err.message);
  }
}


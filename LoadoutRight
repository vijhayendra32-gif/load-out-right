<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>Goods Outflow — Load-Out Control</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#EEF1F3;
    --surface:#FFFFFF;
    --ink:#12181F;
    --ink-soft:#5B6672;
    --line:#D7DCE1;
    --accent:#28496B;
    --accent-ink:#FFFFFF;
    --accent-soft:#E4EBF1;
    --success:#1C7A46;
    --success-soft:#E4F3EA;
    --danger:#C22A2A;
    --danger-soft:#FBE7E7;
    --warning:#B4720E;
    --warning-soft:#FBF0DD;
    --radius:10px;
    --shadow: 0 1px 2px rgba(18,24,31,0.06), 0 6px 20px rgba(18,24,31,0.05);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
    padding-bottom:64px;
  }
  h1,h2,h3,.display{
    font-family:'Barlow Semi Condensed',sans-serif;
    font-weight:800;
    letter-spacing:0.01em;
    margin:0;
  }
  .mono{font-family:'IBM Plex Mono',monospace; font-weight:600; letter-spacing:0.01em;}
  a{color:inherit;}
  button{font-family:inherit;}

  /* ---- App shell ---- */
  header.appbar{
    background:var(--ink);
    color:#fff;
    padding:14px 18px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    position:sticky; top:0; z-index:30;
  }
  header.appbar .brand{display:flex; flex-direction:column; line-height:1.05;}
  header.appbar .brand .eyebrow{
    font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#9FB0BF; font-weight:600;
  }
  header.appbar .brand .title{
    font-family:'Barlow Semi Condensed',sans-serif; font-weight:800; font-size:22px;
  }
  header.appbar .today{font-family:'IBM Plex Mono',monospace; font-size:12px; color:#C9D4DC;}

  nav.tabs{
    display:flex; gap:4px; background:var(--surface);
    border-bottom:1px solid var(--line);
    padding:6px 12px; overflow-x:auto;
    position:sticky; top:58px; z-index:29;
  }
  nav.tabs button{
    border:none; background:transparent; color:var(--ink-soft);
    padding:10px 14px; border-radius:8px; font-size:14px; font-weight:600;
    cursor:pointer; white-space:nowrap;
  }
  nav.tabs button.active{ background:var(--accent-soft); color:var(--accent); }
  nav.tabs button:focus-visible, button:focus-visible, input:focus-visible{
    outline:2px solid var(--accent); outline-offset:2px;
  }

  main{ max-width:960px; margin:0 auto; padding:18px 16px 40px; }
  .view{ display:none; }
  .view.active{ display:block; }

  .card{
    background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);
    padding:18px; margin-bottom:16px; box-shadow:var(--shadow);
  }
  .card h2{ font-size:20px; margin-bottom:4px; }
  .subtext{ color:var(--ink-soft); font-size:13.5px; margin-bottom:14px; }

  label.field{ display:block; margin-bottom:14px; }
  label.field .lbl{ display:block; font-size:12.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--ink-soft); margin-bottom:6px; }
  input[type=date], input[type=text], input[type=file], input[type=time], select{
    width:100%; border:1.5px solid var(--line); border-radius:8px; padding:11px 12px;
    font-size:15px; font-family:'Inter',sans-serif; background:#fff; color:var(--ink);
  }
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    border:none; border-radius:8px; padding:12px 18px; font-size:14.5px; font-weight:700;
    cursor:pointer; min-height:44px;
  }
  .btn-primary{ background:var(--accent); color:#fff; }
  .btn-primary:disabled{ background:#A9B6C1; cursor:not-allowed; }
  .btn-ghost{ background:var(--accent-soft); color:var(--accent); }
  .status-filter-btn.active[data-status=""]{ background:var(--ink); color:#fff; }
  .status-filter-btn.active[data-status="pending"]{ background:var(--warning); color:#fff; }
  .status-filter-btn.active[data-status="in-transit"]{ background:var(--accent); color:#fff; }
  .status-filter-btn.active[data-status="delivered"]{ background:var(--success); color:#fff; }
  .btn-danger{ background:var(--danger); color:#fff; }
  .btn-row{ display:flex; gap:10px; flex-wrap:wrap; }

  .badge{ display:inline-flex; align-items:center; padding:3px 9px; border-radius:999px; font-size:12px; font-weight:700; }
  .badge.pending{ background:var(--warning-soft); color:var(--warning); }
  .badge.in-transit{ background:var(--accent-soft); color:var(--accent); }
  .badge.delivered{ background:var(--success-soft); color:var(--success); }

  table{ width:100%; border-collapse:collapse; font-size:14px; }
  th{ text-align:left; font-size:11.5px; text-transform:uppercase; letter-spacing:0.05em; color:var(--ink-soft); padding:8px 8px; border-bottom:1.5px solid var(--line); }
  td{ padding:9px 8px; border-bottom:1px solid var(--line); }
  tr:last-child td{ border-bottom:none; }

  .zone-card{ border:1.5px solid var(--line); border-radius:var(--radius); margin-bottom:14px; overflow:hidden; }
  .zone-card .zone-head{
    background:var(--ink); color:#fff; padding:14px 16px; display:flex; justify-content:space-between; align-items:center; gap:12px;
  }
  .zone-card .zone-head .zid{ font-family:'Barlow Semi Condensed',sans-serif; font-weight:800; font-size:22px; }
  .zone-card .zone-head .did{ font-family:'IBM Plex Mono',monospace; font-size:13px; color:#C9D4DC; }
  .zone-card .zone-body{ padding:14px 16px; }
  .zone-card .meta-row{ display:flex; gap:18px; margin-bottom:10px; font-size:13px; color:var(--ink-soft); }
  .zone-card .meta-row b{ color:var(--ink); }

  .qr-box{ display:flex; align-items:center; justify-content:center; background:#fff; padding:4px; border-radius:4px; flex-shrink:0; }

  /* Printable ZQR form — mirrors the real IKEA Zone QR & Driver Handout Form */
  .zqr-print{ background:#fff; padding:22px; border:1px solid #bbb; color:#111; font-family:'Inter',sans-serif; }
  .zqr-topbar{ display:flex; justify-content:space-between; align-items:flex-start; border-bottom:3px solid #111; padding-bottom:10px; margin-bottom:14px; }
  .zqr-topbar b{ font-size:19px; }
  .zqr-topbar span{ display:block; font-size:10.5px; color:#555; margin-top:2px; }
  .zqr-formtitle{ text-align:right; }
  .zqr-formtitle b{ font-size:14px; }
  .zqr-infobar{ display:flex; justify-content:space-between; align-items:center; border:1px solid #999; border-radius:4px; padding:14px 16px; margin-bottom:16px; gap:18px; }
  .zqr-infogrid{ display:grid; grid-template-columns:1fr 1fr; gap:12px 30px; flex:1; }
  .zqr-infogrid label{ display:block; font-size:9.5px; letter-spacing:.05em; color:#666; font-weight:700; }
  .zqr-infogrid .val{ font-size:15px; font-weight:700; margin-top:2px; font-family:'IBM Plex Mono',monospace; min-height:18px; }
  .zqr-qrbox{ text-align:center; flex-shrink:0; }
  .zqr-qrbox span{ display:block; font-size:9px; font-weight:700; letter-spacing:.04em; margin-top:4px; color:#333; }
  .zqr-qrbox span.zqr-code-label{ font-size:12px; font-weight:700; letter-spacing:.03em; margin-top:6px; color:#111; }
  .zqr-section-label{ font-size:12.5px; font-weight:800; letter-spacing:.02em; border-top:2px solid #111; padding-top:6px; margin:14px 0 8px; }
  table.zqr-table{ width:100%; border-collapse:collapse; font-size:13px; margin-bottom:6px; }
  table.zqr-table th, table.zqr-table td{ border:1px solid #999; padding:6px 8px; text-align:left; }
  table.zqr-table tr.row-shaded td{ background:#E4E6E9; }
  table.zqr-table th{ background:#f2f2f2; font-size:10.5px; text-transform:uppercase; letter-spacing:.02em; }
  table.zqr-table td.center, table.zqr-table th.center{ text-align:center; }
  .zqr-confirm-text{ font-size:11.5px; color:#333; margin-bottom:12px; }
  .zqr-signoff-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:16px; }
  .zqr-signoff-grid label{ display:block; font-size:9.5px; font-weight:700; letter-spacing:.04em; color:#666; margin-bottom:22px; }
  .zqr-signoff-grid .line{ border-top:1px solid #333; }
  .zqr-footer{ text-align:center; font-size:10px; color:#777; border-top:1px solid #ccc; padding-top:8px; }

  .empty{ text-align:center; padding:40px 16px; color:var(--ink-soft); }
  .empty .display{ font-size:19px; color:var(--ink); margin-bottom:6px; }

  /* Scan view */
  .scan-stage{
    border:2px dashed var(--line); border-radius:14px; padding:26px 18px; text-align:center; margin-bottom:16px;
  }
  .scan-stage.step-a{ border-color:#9FB0BF; }
  .scan-stage.step-b.match{ border-color:var(--success); background:var(--success-soft); }
  .scan-stage.step-b.mismatch{ border-color:var(--danger); background:var(--danger-soft); }
  .scan-result-big{ font-family:'Barlow Semi Condensed',sans-serif; font-weight:800; font-size:30px; margin:6px 0; }
  .manual-zqr-row{ display:flex; gap:8px; max-width:420px; margin:0 auto; }
  .manual-zqr-row input{ flex:1; border:1.5px solid var(--line); border-radius:8px; padding:10px 12px; font-size:14px; font-family:'IBM Plex Mono',monospace; }
  .manual-zqr-row .btn{ min-height:auto; padding:10px 16px; }
  .scan-order-no{ font-size:16px; font-weight:600; color:var(--ink-soft); margin:2px 0 12px; letter-spacing:.02em; }
  .scan-zone-driver{ display:flex; gap:10px; flex-wrap:wrap; margin-bottom:10px; }
  .zd-chip{ font-family:'Barlow Semi Condensed',sans-serif; font-weight:800; font-size:26px; padding:6px 16px; border-radius:8px; line-height:1.15; }
  .zd-chip.zone{ background:var(--accent); color:#fff; }
  .zd-chip.driver{ background:var(--success); color:#fff; }
  #camVideo{ width:100%; max-width:360px; border-radius:10px; background:#000; }
  #camCanvas{ display:none; }

  .toast{
    position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
    background:var(--ink); color:#fff; padding:11px 18px; border-radius:999px; font-size:13.5px;
    box-shadow:var(--shadow); z-index:100; opacity:0; pointer-events:none; transition:opacity .2s;
  }
  .toast.show{ opacity:1; }

  /* Modal */
  .modal-overlay{
    position:fixed; inset:0; background:rgba(18,24,31,0.55); display:none; align-items:flex-start; justify-content:center;
    padding:24px 12px; z-index:200; overflow-y:auto;
  }
  .modal-overlay.show{ display:flex; }
  .modal{ background:#fff; border-radius:12px; max-width:520px; width:100%; padding:0; overflow:hidden; }
  .modal.pdf-modal{ max-width:900px; max-height:88vh; display:flex; flex-direction:column; }
  .modal.pdf-modal .modal-body{ flex:1; overflow-y:auto; padding:0; }
  .pdf-saved-banner{ background:var(--success-soft); color:var(--success); font-size:13.5px; font-weight:600; padding:12px 20px; border-bottom:1px solid var(--line); }
  .pdf-preview-area{ padding:20px; background:#e7eaed; }
  .pdf-preview-area .zqr-print{ margin-bottom:16px; max-width:760px; margin-left:auto; margin-right:auto; }
  .modal-head{ display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-bottom:1px solid var(--line); }
  .modal-head button{ border:none; background:none; font-size:20px; cursor:pointer; color:var(--ink-soft); }
  .modal-body{ padding:18px; max-height:70vh; overflow-y:auto; }

  /* Printable form styling (also used inside preview modal) */
  @media print{
    body *{ visibility:hidden; }
    #printArea, #printArea *{ visibility:visible; }
    #printArea{ display:block !important; position:absolute; top:0; left:0; width:100%; }
    .zqr-print{ border:none; page-break-after:always; }
  }

  /* Report */
  table.report-auto-table{ width:100%; border-collapse:collapse; font-size:14px; }
  table.report-auto-table th{ text-align:left; padding:9px 4px; border-bottom:1px solid var(--line); font-weight:600; color:var(--ink); font-size:13.5px; }
  table.report-auto-table td{ text-align:right; padding:9px 4px; border-bottom:1px solid var(--line); font-weight:700; }
  table.report-auto-table tr:last-child th, table.report-auto-table tr:last-child td{ border-bottom:none; }
  .report-sub{ font-weight:400; color:var(--ink-soft); font-size:12px; text-transform:none; letter-spacing:0; }
  .failed-order-chip{ display:inline-flex; align-items:center; background:var(--danger-soft); color:var(--danger); font-family:'IBM Plex Mono',monospace; font-weight:700; font-size:13px; padding:5px 10px; border-radius:6px; margin:3px 6px 3px 0; }
  .report-issues-box{ border:1px solid #999; border-radius:4px; padding:10px 12px; font-size:13px; color:#222; min-height:24px; }

  /* Dashboard */
  .dash-stats{ display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .dash-stat{ border-radius:10px; padding:16px 14px; text-align:center; border:1.5px solid var(--line); }
  .dash-stat-num{ font-family:'Barlow Semi Condensed',sans-serif; font-weight:800; font-size:34px; line-height:1; }
  .dash-stat-label{ font-size:13px; font-weight:700; margin-top:6px; text-transform:uppercase; letter-spacing:.04em; }
  .dash-stat-sub{ font-size:11.5px; color:var(--ink-soft); margin-top:4px; }
  .dash-stat.pending{ background:var(--warning-soft); }
  .dash-stat.pending .dash-stat-num, .dash-stat.pending .dash-stat-label{ color:var(--warning); }
  .dash-stat.in-transit{ background:var(--accent-soft); }
  .dash-stat.in-transit .dash-stat-num, .dash-stat.in-transit .dash-stat-label{ color:var(--accent); }
  .dash-stat.delivered{ background:var(--success-soft); }
  .dash-stat.delivered .dash-stat-num, .dash-stat.delivered .dash-stat-label{ color:var(--success); }
  .dash-bar-row{ display:flex; align-items:center; gap:12px; margin-bottom:10px; }
  .dash-bar-label{ width:90px; font-size:12.5px; font-weight:700; color:var(--ink-soft); flex-shrink:0; }
  .dash-bar-track{ flex:1; background:var(--bg); border-radius:6px; height:22px; overflow:hidden; }
  .dash-bar-fill{ height:100%; border-radius:6px; transition:width .4s ease; }
  .dash-bar-fill.pending{ background:var(--warning); }
  .dash-bar-fill.in-transit{ background:var(--accent); }
  .dash-bar-fill.delivered{ background:var(--success); }
  .dash-bar-count{ width:36px; text-align:right; font-family:'IBM Plex Mono',monospace; font-weight:600; font-size:13px; flex-shrink:0; }
  .dash-delivery-times{ display:flex; gap:12px; margin-top:18px; padding-top:16px; border-top:1px solid var(--line); }
  .dash-delivery-time{ flex:1; background:var(--bg); border-radius:8px; padding:12px 14px; }
  .dash-delivery-time .lbl{ display:block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-soft); margin-bottom:4px; }
  .dash-delivery-time .val{ font-size:16px; font-weight:600; }
  .driver-row{ margin-bottom:16px; }
  .driver-row:last-child{ margin-bottom:0; }
  .driver-row-head{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:6px; font-size:13px; }
  .driver-row-head .driver-id{ font-weight:700; font-size:14px; }
  .driver-row-head .driver-pct{ color:var(--ink-soft); }
  .driver-status{ margin-left:auto; padding:2px 9px; border-radius:999px; font-size:11.5px; font-weight:700; }
  .driver-status.ontime{ background:var(--success-soft); color:var(--success); }
  .driver-status.pending{ background:var(--bg); color:var(--ink-soft); }
  .driver-status.late{ background:var(--danger-soft); color:var(--danger); }
  .driver-status.failed{ background:var(--danger); color:#fff; }
  .driver-bar-track{ display:flex; height:22px; border-radius:6px; overflow:hidden; background:var(--bg); position:relative; }
  .driver-bar-seg{ height:100%; transition:width .4s ease; }
  .driver-bar-seg.pending{ background:var(--warning); }
  .driver-bar-seg.in-transit{ background:var(--accent); }
  .driver-bar-seg.delivered{ background:var(--success); }
  .driver-bar-seg.failed{ background:var(--danger); background-image:repeating-linear-gradient(45deg, rgba(255,255,255,0.25) 0, rgba(255,255,255,0.25) 4px, transparent 4px, transparent 8px); }
  .driver-bar-track.overdue{ box-shadow: inset 0 0 0 2px var(--danger); }

  @media (max-width:600px){
    header.appbar .today{ display:none; }
    .zone-card .meta-row{ flex-wrap:wrap; gap:8px 18px; }
    .dash-stats{ grid-template-columns:1fr; }
  }
</style>
</head>
<body>

<header class="appbar">
  <div class="brand">
    <span class="eyebrow">Goods Outflow</span>
    <span class="title">Load-Out Control</span>
  </div>
  <span class="today mono" id="todayLabel"></span>
</header>

<nav class="tabs" id="tabs">
  <button data-view="dashboard" class="active">Dashboard</button>
  <button data-view="upload">Upload</button>
  <button data-view="forms">ZQR Forms</button>
  <button data-view="scan">Scan</button>
  <button data-view="search">Records</button>
  <button data-view="report">Report</button>
</nav>

<main>

  <!-- DASHBOARD VIEW -->
  <section class="view active" id="view-dashboard">
    <div class="card">
      <h2>Live status</h2>
      <div class="subtext">Updates automatically. Defaults to today — pick another date to see that day instead.</div>
      <label class="field" style="max-width:220px;">
        <span class="lbl">Date</span>
        <input type="date" id="dashDate"/>
      </label>
    </div>

    <div class="card">
      <div class="dash-stats">
        <div class="dash-stat pending">
          <div class="dash-stat-num" id="dashPendingNum">0</div>
          <div class="dash-stat-label">Pending</div>
          <div class="dash-stat-sub">Not yet scanned</div>
        </div>
        <div class="dash-stat in-transit">
          <div class="dash-stat-num" id="dashTransitNum">0</div>
          <div class="dash-stat-label">In Transit</div>
          <div class="dash-stat-sub">First scan done, heading to zone</div>
        </div>
        <div class="dash-stat delivered">
          <div class="dash-stat-num" id="dashDeliveredNum">0</div>
          <div class="dash-stat-label">Delivered</div>
          <div class="dash-stat-sub">ZQR confirmed at zone</div>
        </div>
      </div>
      <div id="dashChart" style="margin-top:20px;"></div>
      <div id="dashDeliveryTimes" class="dash-delivery-times" style="display:none;">
        <div class="dash-delivery-time"><span class="lbl">First Delivered</span><span class="val mono" id="dashFirstDelivered">—</span></div>
        <div class="dash-delivery-time"><span class="lbl">Last Delivered</span><span class="val mono" id="dashLastDelivered">—</span></div>
      </div>
      <div class="subtext" id="dashEmpty" style="display:none; text-align:center; padding:20px 0;">No orders uploaded for this date yet.</div>
    </div>

    <div class="card" id="dashDriverCard" style="display:none;">
      <h2>Driver progress</h2>
      <div class="subtext">Target: all deliveries complete by 07:00. Bars past the line show minutes over.</div>
      <div id="dashDriverProgress"></div>
    </div>
  </section>

  <!-- UPLOAD VIEW -->
  <section class="view" id="view-upload">
    <div class="card">
      <h2>Upload today's order file</h2>
      <div class="subtext">Upload the Excel export for a day. Uploading again for the same date replaces that day's data — other days are kept for 3 days, then automatically removed.</div>
      <label class="field">
        <span class="lbl">Date</span>
        <input type="date" id="uploadDate"/>
      </label>
      <label class="field">
        <span class="lbl">Excel file (.xlsx / .csv)</span>
        <input type="file" id="uploadFile" accept=".xlsx,.xls,.csv"/>
      </label>
      <div class="btn-row">
        <button class="btn btn-primary" id="processBtn">Process file</button>
      </div>
      <div id="uploadStatus" style="margin-top:14px; font-size:13.5px;"></div>
    </div>

    <div class="card" id="uploadPreviewCard" style="display:none;">
      <h2>Upload summary</h2>
      <div class="subtext" id="uploadSummaryText"></div>
      <div class="btn-row">
        <button class="btn btn-primary" id="printAllBtn">Print all ZQR forms</button>
        <button class="btn btn-ghost" id="goToFormsBtn">View ZQR forms</button>
      </div>
    </div>

    <div class="card">
      <h2>Clear data</h2>
      <div class="subtext">Permanently deletes all uploaded records, ZQR forms, and scan progress for the date selected above. This cannot be undone.</div>
      <div class="btn-row">
        <button class="btn btn-danger" id="clearDateBtn">Clear data for this date</button>
      </div>
      <div id="clearDateStatus" style="margin-top:12px; font-size:13.5px;"></div>
    </div>
  </section>

  <!-- FORMS VIEW -->
  <section class="view" id="view-forms">
    <div class="card">
      <h2>ZQR handout forms</h2>
      <div class="subtext">Grouped by Zone/Bay + Driver. Each form covers one zone/driver combination.</div>
      <label class="field" style="max-width:220px;">
        <span class="lbl">Date</span>

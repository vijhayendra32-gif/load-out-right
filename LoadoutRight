async function renderFormsList(){
  const date = document.getElementById('formsDate').value || todayISO();
  const listEl = document.getElementById('formsList');
  const day = await loadDay(date);
  if(!day || !day.records.length){
    listEl.innerHTML = '<div class="card empty"><div class="display">No data for '+date+'</div>Upload a file for this date to generate forms.</div>';
    return;
  }
  const groups = groupByZoneDriver(day.records);
  listEl.innerHTML = groups.map((g,i)=>{
    const delivered = g.records.filter(r=>r.status==='delivered').length;
    const items = g.records.reduce((s,r)=>s+r.items,0);
    return '<div class="zone-card">'
      + '<div class="zone-head"><div><div class="zid">Zone '+escapeHtml(g.zone)+'</div>'
      + '<div class="did">Driver '+escapeHtml(g.driverNo)+'</div></div>'
      + '<div class="badge '+(delivered===g.records.length?'delivered':'pending')+'">'+delivered+' / '+g.records.length+' delivered</div></div>'
      + '<div class="zone-body">'
      + '<div class="meta-row"><span><b>'+g.records.length+'</b> orders</span><span><b>'+items+'</b> items</span></div>'
      + '<div class="btn-row">'
      + '<button class="btn btn-ghost" onclick="viewForm(\''+date+'\','+i+')">View</button>'
      + '<button class="btn btn-primary" onclick="viewFormPdf(\''+date+'\','+i+')">View PDF</button>'
      + '<button class="btn btn-ghost" onclick="printForms(\''+date+'\','+i+')">Print (browser dialog)</button>'
      + '</div></div></div>';
  }).join('');
  listEl.dataset.date = date;
  window._formsCache = groups;
}


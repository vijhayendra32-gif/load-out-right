function yesNoLabel(v){
  return v==='yes' ? 'Yes' : v==='no' ? 'No' : '—';
}

async function computeReportData(date){
  const manual = await loadReportData(date);
  const day = await loadDay(date);
  const records = day ? day.records : [];
  const externalReturns = day ? (day.externalReturns || []) : [];
  const preloadOrders = day ? (day.preloadOrders || []) : [];

  const driverNos = [...new Set(records.map(r=>String(r.driverNo).trim()))];
  const vans = driverNos.filter(d=>/^\d{4}$/.test(d)).length;
  const trucks = driverNos.filter(d=>/^\d{3}$/.test(d)).length;

  const deliveredTimes = records.filter(r=>r.status==='delivered' && r.deliveredAt).map(r=>r.deliveredAt).sort();
  const fmt = (iso)=> new Date(iso).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'});

  const driverMap = {};
  records.forEach(r=>{
    const key = r.driverNo;
    if(!driverMap[key]) driverMap[key] = { driverNo:r.driverNo, zone:r.zone, hasNetley:false, orderCount:0 };
    driverMap[key].orderCount++;
    if(r.isNetley) driverMap[key].hasNetley = true;
  });
  const driverSnapshot = Object.values(driverMap).sort((a,b)=> String(a.driverNo).localeCompare(String(b.driverNo)));

  const preloadMap = {};
  preloadOrders.forEach(r=>{
    const key = r.zone;
    if(!preloadMap[key]) preloadMap[key] = { zone:r.zone, drivers:new Set(), orderCount:0 };
    preloadMap[key].orderCount++;
    preloadMap[key].drivers.add(r.driverNo);
  });
  const preloadSnapshot = Object.values(preloadMap)
    .map(p=>({ zone:p.zone, driverNo:[...p.drivers].join(', '), orderCount:p.orderCount }))
    .sort((a,b)=> String(a.zone).localeCompare(String(b.zone)));

  return {
    manual,
    vans, trucks,
    totalOrders: records.length,
    totalPreload: preloadOrders.length,
    totalNetley: records.filter(r=>r.isNetley).length,
    firstDelivery: deliveredTimes.length ? fmt(deliveredTimes[0]) : '—',
    lastDelivery: deliveredTimes.length ? fmt(deliveredTimes[deliveredTimes.length-1]) : '—',
    driverSnapshot,
    preloadSnapshot,
    failedRecords: records.filter(r=>isReportFailed(r, date)),
    externalReturns
  };
}


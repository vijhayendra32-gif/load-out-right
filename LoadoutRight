let lastUploadDate = null;

document.getElementById('processBtn').addEventListener('click', async ()=>{
  const file = document.getElementById('uploadFile').files[0];
  const date = document.getElementById('uploadDate').value;
  const statusEl = document.getElementById('uploadStatus');
  if(!file){ statusEl.textContent = 'Choose a file first.'; return; }
  if(!date){ statusEl.textContent = 'Choose a date first.'; return; }
  statusEl.textContent = 'Reading file…';

  try{
    const data = await file.arrayBuffer();
    const wb = XLSX.read(data, {type:'array'});

    // Use the first VISIBLE sheet — skip hidden/very-hidden sheets entirely.
    let sheetName = wb.SheetNames[0];
    if(wb.Workbook && wb.Workbook.Sheets){
      const visibleSheet = wb.Workbook.Sheets.find(s => s && s.name && !s.Hidden);
      if(visibleSheet) sheetName = visibleSheet.name;
    }
    const sheet = wb.Sheets[sheetName];

    const rows = XLSX.utils.sheet_to_json(sheet, {header:1, defval:''});
    if(rows.length < 2){ statusEl.textContent = 'File has no data rows.'; return; }

    // !rows and !cols hidden flags use ABSOLUTE sheet indices (from row 0 / column A),
    // but sheet_to_json's output array is indexed relative to the used range's start —
    // convert absolute to relative so hidden rows/columns are matched correctly even
    // when the data doesn't start at the very top-left of the sheet.
    const range = XLSX.utils.decode_range(sheet['!ref'] || 'A1');

    // Hidden columns are blanked out before column detection so a hidden column's
    // header can never be matched — its data is then never read for any field.
    const hiddenCols = new Set();
    if(sheet['!cols']){
      sheet['!cols'].forEach((c, absIdx)=>{
        if(c && c.hidden){ const relIdx = absIdx - range.s.c; if(relIdx>=0) hiddenCols.add(relIdx); }
      });
    }
    const headerRow = rows[0].map((h, idx) => hiddenCols.has(idx) ? '' : h);
    const cols = detectColumns(headerRow);
    const missing = ['orderNo','driverNo','zone','suburb','items'].filter(f=>cols[f]===undefined);
    if(missing.length){
      statusEl.innerHTML = 'Could not find column(s): <b>'+missing.join(', ')+'</b>. Check the file headers.';
      return;
    }

    // Hidden rows are skipped entirely — never counted as orders.
    const hiddenRows = new Set();
    if(sheet['!rows']){
      sheet['!rows'].forEach((r, absIdx)=>{
        if(r && r.hidden){ const relIdx = absIdx - range.s.r; if(relIdx>=0) hiddenRows.add(relIdx); }
      });
    }

    const records = [];
    const externalReturns = [];
    const preloadOrders = [];
    const seenSignatures = new Set();
    let duplicatesSkipped = 0;
    for(let i=1;i<rows.length;i++){
      if(hiddenRows.has(i)) continue;
      const r = rows[i];
      if(!r || r.every(c=>c==='' || c==null)) continue;
      const orderNo = String(r[cols.orderNo]||'').trim();
      if(!orderNo) continue;
      const details = cols.details!==undefined ? String(r[cols.details]||'').trim() : '';
      const rec = {
        id: uid(),
        category: cols.category!==undefined ? String(r[cols.category]||'').trim() : '',
        orderNo,
        driverNo: String(r[cols.driverNo]||'').trim(),
        driverName: cols.driverName!==undefined ? String(r[cols.driverName]||'').trim() : '',
        zone: String(r[cols.zone]||'').trim(),
        suburb: String(r[cols.suburb]||'').trim(),
        items: Number(r[cols.items])||0,
        details,
        isNetley: /fullserve/i.test(details),
        status: 'pending',
        loadedAt: null
      };
      // Skip exact duplicates — every source column value must match another
      // already-seen row for it to be dropped (not just a repeated order no.).
      const signature = [rec.category, rec.orderNo, rec.driverNo, rec.driverName, rec.zone, rec.suburb, rec.items, rec.details].join('␟');
      if(seenSignatures.has(signature)){ duplicatesSkipped++; continue; }
      seenSignatures.add(signature);

      if(isPreload(rec)){
        // PL# zone orders (preload) are excluded from the main dataset entirely —
        // no ZQR form, no Scan/in-transit/delivered status, no Dashboard — and only
        // surfaced in the Report's Preload table.
        preloadOrders.push(rec);
      }else if(/[A-Za-z]/.test(orderNo)){
        // Alphanumeric order numbers are external returns — excluded from the main
        // dataset (ZQR forms, Dashboard, Scan, Records) and only surfaced in the
        // Report's External Returns Assigned table.
        externalReturns.push(rec);
      }else{
        records.push(rec);
      }
    }
    if(!records.length && !externalReturns.length && !preloadOrders.length){ statusEl.textContent = 'No valid order rows found.'; return; }

    const dayObj = { date, uploadedAt: new Date().toISOString(), records, externalReturns, preloadOrders };
    await saveDay(date, dayObj);
    await addDateToIndex(date);
    const withinRetention = date >= isoDaysAgo(RETENTION_DAYS-1);
    await cleanupOldData();

    const groups = groupByZoneDriver(records);
    lastUploadGroups = groups;
    lastUploadDate = date;

    statusEl.innerHTML = '<span style="color:var(--success); font-weight:700;">Saved '+records.length+' orders for '+date+'.</span>'
      + (withinRetention ? '' : ' <span style="color:var(--warning); font-weight:600;">Note: this date is older than the '+RETENTION_DAYS+'-day retention window and will be removed on next cleanup.</span>');
    document.getElementById('uploadPreviewCard').style.display = 'block';
    document.getElementById('uploadSummaryText').textContent =
      records.length+' orders across '+groups.length+' zone/driver group(s), '+
      records.reduce((s,r)=>s+r.items,0)+' total items.';

    document.getElementById('formsDate').value = date;
  }catch(err){
    console.error(err);
    statusEl.textContent = 'Could not read that file. Make sure it is a valid .xlsx/.csv export.';
  }
});

function groupByZoneDriver(records){
  const map = {};
  records.forEach(r=>{
    const key = r.zone+'␟'+r.driverNo;
    if(!map[key]) map[key] = {zone:r.zone, driverNo:r.driverNo, driverName:r.driverName||'', records:[]};
    if(!map[key].driverName && r.driverName) map[key].driverName = r.driverName;
    map[key].records.push(r);
  });
  return Object.values(map).sort((a,b)=> (a.zone+a.driverNo).localeCompare(b.zone+b.driverNo));
}


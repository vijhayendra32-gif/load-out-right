    if(searchHasRun) runSearch();
    if(recordsInterval) clearInterval(recordsInterval);
    recordsInterval = setInterval(()=>{ liveOrderLookup(); if(searchHasRun) runSearch(); }, 3000);
  }else if(recordsInterval){
